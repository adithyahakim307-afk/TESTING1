# Salin file ini jadi `.env` di server hosting, lalu isi nilainya. JANGAN commit file .env ke GitHub.

# Dari https://my.telegram.org
API_ID=123456
API_HASH=isi_api_hash_kamu

# Token bot kontrol (dari @BotFather) -> bot yang kamu ajak bicara
BOT_TOKEN=isi_token_bot_kontrol

# Endpoint Cloudflare Worker (pisahkan dengan koma kalau lebih dari satu), tanpa "/" di akhir
ENDPOINTS=https://frag1.NAMAKAMU.workers.dev
# Harus sama persis dengan variabel SECRET di Cloudflare Worker
ENDPOINT_KEY=isi_secret_kamu
# 1 = ikut pakai IP server hosting langsung, 0 = hanya lewat worker
USE_DIRECT=1

# Laju pengecekan (naikkan pelan-pelan kalau stabil)
PER_ACCOUNT_DELAY=0.3
TARGET_RATE=10

# Opsional
# DATA_DIR=data
# KEEPER_CLAIM=0
# TZ_OFFSET_HOURS=7
